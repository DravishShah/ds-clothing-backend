// 1. The Generator (Tells Prisma to build the JavaScript client)
generator client {
  provider = "prisma-client-js"
}

// 2. The Datasource (Tells Prisma where to find your Neon database)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. Your Custom Vault Table
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  gender      String
  price       Int      
  image       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// NEW: The Members Club Table
model Customer {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // We will hash this in Node.js!
  name      String
  address   String?  // Optional: they can save an address later
  orders    Order[]  // A customer can have many orders
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id           Int       @id @default(autoincrement())
  customerName String
  email        String
  totalAmount  Int
  status       String    @default("Pending")
  createdAt    DateTime  @default(now())

  // NEW: The Optional Link to the Customer
  customerId   Int?      // The '?' makes it optional for Guest Checkout
  customer     Customer? @relation(fields: [customerId], references: [id])
}

// The Admin Vault (Keep this isolated for security)
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String 
  name     String
}